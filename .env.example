# Optional. Increases the GitHub API rate limit for repository inspection.
# Copy this file to .env.local and add a fine-grained token with public
# repository read access. Never commit the real token.
GITHUB_TOKEN=

# Required beginning with Checkpoint 1. Never commit a real Backboard key.
BACKBOARD_API_KEY=

# Optional Backboard provider and model overrides.
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL_NAME=

# Optional. Used by the header link once the workshop starter is published.
VITE_STARTER_REPO_URL=
